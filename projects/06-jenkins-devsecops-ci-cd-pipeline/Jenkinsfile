// DevSecOps pipeline for a small Flask app. Everything runs locally.
//
// Every `docker` command below talks to the isolated Docker-in-Docker sidecar
// (DOCKER_HOST is set in the Jenkins container), never to the host Docker.
// No stage uses a cloud credential, and none touches AWS: the S3 Terraform in
// terraform/ is only ever read by the scanner.
//
// Optional: with RUN_SNYK_JIRA ticked, a Snyk dependency gate runs right after the unit tests and a
// Jira ticket is opened if the build fails. Both are off by default, and with the box unticked the
// pipeline is exactly the 12 stages below. The Snyk and Jira values are Jenkins credentials that
// come from 1Password through scripts/up.sh; they are bound with withCredentials, never echoed.

pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
        timeout(time: 45, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        IMAGE          = "sample-app:${env.BUILD_NUMBER}"
        TEST_IMAGE     = "sample-app-test:${env.BUILD_NUMBER}"
        APP_NAME       = "sample-app-${env.BUILD_NUMBER}"
        APP_NET        = "app-net-${env.BUILD_NUMBER}"
        // Pinned tool images (run inside the Docker-in-Docker daemon)
        TRIVY_IMAGE    = 'aquasec/trivy:0.74.0'
        ZAP_IMAGE      = 'ghcr.io/zaproxy/zaproxy:2.17.0'
        GITLEAKS_IMAGE = 'ghcr.io/gitleaks/gitleaks:v8.30.1'
        HELPER_IMAGE   = 'python:3.12.15-slim-bookworm'
        // Optional Snyk stage. Pinned by digest (the python-3.12 tag as of 2026-10-04). The image is
        // published for linux/amd64 only, so it runs under emulation on an Apple-silicon Docker.
        SNYK_IMAGE     = 'snyk/snyk@sha256:2bf614cc097023e2f391ddd6953365f72d84167e16b1e9eaa11c5ef8891dda9b'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh '''#!/bin/bash
                    set -euo pipefail
                    rm -rf reports
                    mkdir -p reports/zap reports/trivy reports/gitleaks
                    chmod -R 777 reports
                    git log -1 --oneline
                '''
            }
        }

        stage('Build image') {
            steps {
                sh '''#!/bin/bash
                    set -euo pipefail
                    docker build --progress=plain --target runtime -t "$IMAGE" app
                    docker build --progress=plain --target test -t "$TEST_IMAGE" app
                '''
            }
        }

        stage('Unit tests') {
            steps {
                // The workspace is mounted at the same path inside the tool container, so the
                // coverage report carries paths that SonarQube can resolve.
                sh '''#!/bin/bash
                    set -euo pipefail
                    docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp \
                        -v "$WORKSPACE:$WORKSPACE" -w "$WORKSPACE/app" "$TEST_IMAGE" \
                        python -m pytest -p no:cacheprovider --cov=main \
                            --cov-report=xml:"$WORKSPACE/reports/coverage.xml" --cov-report=term \
                            --junitxml="$WORKSPACE/reports/junit.xml"
                '''
            }
            post {
                always {
                    junit testResults: 'reports/junit.xml', allowEmptyResults: false
                }
            }
        }

        stage('Snyk dependency scan (optional)') {
            when { expression { params.RUN_SNYK_JIRA } }
            steps {
                script {
                    if (env.SNYK_JIRA_ENABLED != '1') {
                        error('RUN_SNYK_JIRA is ticked, but this stack was started without the Snyk and Jira secrets. Start it with: op run --env-file=jenkins/.env.op -- ./scripts/up.sh')
                    }
                }
                // Gate: any HIGH or CRITICAL finding in the app's pinned dependencies fails the build.
                // The pip packages are installed inside the scan container first so Snyk can resolve them.
                // There is no --skip-unresolved: a dependency Snyk cannot resolve is an error, not a pass.
                // This stage never runs `snyk monitor` or `snyk auth`; the token is read from SNYK_TOKEN.
                withCredentials([
                    string(credentialsId: 'snyk-token', variable: 'SNYK_TOKEN'),
                    string(credentialsId: 'snyk-org', variable: 'SNYK_ORG')
                ]) {
                    sh '''#!/bin/bash
                        set +x
                        set -uo pipefail
                        mkdir -p reports/snyk
                        rc=0
                        docker run --rm --platform linux/amd64 --user "$(id -u):$(id -g)" -e HOME=/tmp \
                            -e SNYK_TOKEN -e SNYK_ORG -e SNYK_DISABLE_ANALYTICS=1 -e OUT="$WORKSPACE/reports/snyk" \
                            -v "$WORKSPACE:$WORKSPACE" -w "$WORKSPACE/app" --entrypoint bash "$SNYK_IMAGE" -c '
                                set -uo pipefail
                                pip install --user --no-cache-dir --quiet -r requirements.txt || exit 2
                                snyk test --file=requirements.txt --package-manager=pip \
                                    --severity-threshold=high --org="$SNYK_ORG" \
                                    --json-file-output="$OUT/snyk-raw.json" > "$OUT/snyk-raw.txt" 2>&1
                            ' || rc=$?
                        # Snyk prints the organisation name; drop that line before anything is shown or archived.
                        sed '/^Organization:/d' reports/snyk/snyk-raw.txt | tee reports/snyk/snyk-report.txt || true
                        if [ -s reports/snyk/snyk-raw.json ]; then
                            docker run --rm -v "$WORKSPACE/reports/snyk:/w" "$HELPER_IMAGE" python -c '
import json
d = json.load(open("/w/snyk-raw.json"))
for item in (d if isinstance(d, list) else [d]):
    item.pop("org", None)
json.dump(d, open("/w/snyk-sanitized.json", "w"), indent=2)
'
                        fi
                        rm -f reports/snyk/snyk-raw.txt reports/snyk/snyk-raw.json
                        echo "snyk exit code: $rc (0 = no HIGH or CRITICAL findings, 1 = findings, 2 or more = the scan itself failed)"
                        exit "$rc"
                    '''
                }
            }
        }

        stage('SonarQube analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh 'sonar-scanner -Dsonar.projectBaseDir="$WORKSPACE" -Dsonar.scm.disabled=true'
                }
            }
        }

        stage('Quality gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Secret scan (gitleaks)') {
            steps {
                sh '''#!/bin/bash
                    set -euo pipefail
                    docker run --rm -v "$WORKSPACE:/repo:ro" -v "$WORKSPACE/reports/gitleaks:/out" \
                        "$GITLEAKS_IMAGE" dir /repo --no-banner --redact --exit-code 1 \
                        --report-format json --report-path /out/gitleaks.json
                '''
            }
        }

        stage('Trivy: filesystem') {
            steps {
                // Gate: any fixable HIGH or CRITICAL vulnerability or any secret fails the build.
                sh '''#!/bin/bash
                    set -euo pipefail
                    docker run --rm -v "$WORKSPACE:/src:ro" -v "$WORKSPACE/reports/trivy:/out" \
                        -v trivy-cache:/root/.cache "$TRIVY_IMAGE" fs --scanners vuln,secret \
                        --severity HIGH,CRITICAL --ignore-unfixed --no-progress --skip-dirs /src/reports \
                        --format json --output /out/trivy-fs.json --exit-code 0 /src
                    docker run --rm -v "$WORKSPACE:/src:ro" -v trivy-cache:/root/.cache \
                        "$TRIVY_IMAGE" fs --scanners vuln,secret \
                        --severity HIGH,CRITICAL --ignore-unfixed --no-progress --skip-dirs /src/reports \
                        --exit-code 1 /src 2>&1 | tee reports/trivy/trivy-fs.txt
                '''
            }
        }

        stage('Trivy: image') {
            steps {
                sh '''#!/bin/bash
                    set -euo pipefail
                    trap 'rm -f reports/trivy/image.tar' EXIT
                    docker save "$IMAGE" -o reports/trivy/image.tar
                    docker run --rm -v "$WORKSPACE/reports/trivy:/out" -v trivy-cache:/root/.cache \
                        "$TRIVY_IMAGE" image --input /out/image.tar --scanners vuln \
                        --severity HIGH,CRITICAL --ignore-unfixed --no-progress \
                        --format json --output /out/trivy-image.json --exit-code 0
                    docker run --rm -v "$WORKSPACE/reports/trivy:/out" -v trivy-cache:/root/.cache \
                        "$TRIVY_IMAGE" image --input /out/image.tar --scanners vuln \
                        --severity HIGH,CRITICAL --ignore-unfixed --no-progress \
                        --exit-code 1 2>&1 | tee reports/trivy/trivy-image.txt
                '''
            }
        }

        stage('Trivy: Terraform (IaC)') {
            steps {
                // The S3 Terraform is a scan target only: it is read, never planned or applied.
                sh '''#!/bin/bash
                    set -euo pipefail
                    docker run --rm -v "$WORKSPACE/terraform:/src:ro" -v "$WORKSPACE/reports/trivy:/out" \
                        -v trivy-cache:/root/.cache "$TRIVY_IMAGE" config --severity HIGH,CRITICAL \
                        --format json --output /out/trivy-terraform.json --exit-code 0 /src
                    docker run --rm -v "$WORKSPACE/terraform:/src:ro" -v trivy-cache:/root/.cache \
                        "$TRIVY_IMAGE" config --severity HIGH,CRITICAL \
                        --exit-code 1 /src 2>&1 | tee reports/trivy/trivy-terraform.txt
                '''
            }
        }

        stage('Deploy to a local container') {
            steps {
                sh '''#!/bin/bash
                    set -euo pipefail
                    docker network create "$APP_NET"
                    docker run -d --name "$APP_NAME" --network "$APP_NET" \
                        --read-only --tmpfs /dev/shm --cap-drop ALL \
                        --security-opt no-new-privileges:true "$IMAGE"
                    status=starting
                    for i in $(seq 1 30); do
                        status=$(docker inspect -f '{{.State.Health.Status}}' "$APP_NAME")
                        [ "$status" = "healthy" ] && break
                        sleep 2
                    done
                    echo "container health: $status"
                    if [ "$status" != "healthy" ]; then docker logs "$APP_NAME"; exit 1; fi
                '''
            }
        }

        stage('OWASP ZAP baseline') {
            steps {
                // Scans only the container deployed above, over the private Docker network.
                sh '''#!/bin/bash
                    set -euo pipefail
                    cp zap-rules.conf reports/zap/zap-rules.conf
                    docker run --rm --network "$APP_NET" -v "$WORKSPACE/reports/zap:/zap/wrk:rw" \
                        "$ZAP_IMAGE" zap-baseline.py -t "http://$APP_NAME:8000" -c zap-rules.conf \
                        -r zap-baseline.html -J zap-baseline.json -w zap-baseline.md -I
                '''
            }
        }

        stage('Publish reports') {
            steps {
                publishHTML(target: [
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'reports/zap',
                    reportFiles: 'zap-baseline.html',
                    reportName: 'ZAP baseline report'
                ])
                archiveArtifacts artifacts: 'reports/**', fingerprint: true
            }
        }
    }

    post {
        always {
            // Teardown always runs, pass or fail: remove the deployed container, its network and the images.
            sh '''#!/bin/bash
                set +e
                docker rm -f "$APP_NAME" >/dev/null 2>&1
                docker network rm "$APP_NET" >/dev/null 2>&1
                docker rmi -f "$IMAGE" "$TEST_IMAGE" >/dev/null 2>&1
                rm -f reports/trivy/image.tar
                echo "teardown: containers left for this build: $(docker ps -aq --filter name=sample-app-$BUILD_NUMBER | wc -l)"
                exit 0
            '''
            archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true
            // Scanner containers run as root; hand their files back so the next run can clean the workspace.
            sh '''#!/bin/bash
                docker run --rm --user 0 -v "$WORKSPACE:/w" "$HELPER_IMAGE" chown -R 1000:1000 /w || true
            '''
        }
        success { echo 'Pipeline finished: every gate passed.' }
        failure {
            echo 'Pipeline failed: a gate blocked this build. See the failed stage above.'
            script {
                if (params.RUN_SNYK_JIRA && env.SNYK_JIRA_ENABLED == '1') {
                    try {
                        // Branch names are untrusted: they travel as environment variables and the JSON is
                        // built by python's json module, never by string concatenation. The ticket holds the
                        // job name, branch, build number, failed stage and a pointer to the archived reports;
                        // no secret, e-mail or site URL.
                        withEnv(["FAILED_STAGE=${env.STAGE_NAME ?: 'unknown'}", "TICKET_BRANCH=${params.BRANCH}"]) {
                            withCredentials([
                                string(credentialsId: 'jira-api-token', variable: 'JIRA_API_TOKEN'),
                                string(credentialsId: 'jira-email', variable: 'JIRA_EMAIL'),
                                string(credentialsId: 'jira-site-url', variable: 'JIRA_SITE_URL'),
                                string(credentialsId: 'jira-project-key', variable: 'JIRA_PROJECT_KEY')
                            ]) {
                                sh '''#!/bin/bash
                                    set +x
                                    set +e
                                    payload_file="$(mktemp)"; response_file="$(mktemp)"
                                    docker run --rm -e JIRA_PROJECT_KEY -e JOB_NAME -e BUILD_NUMBER -e TICKET_BRANCH -e FAILED_STAGE \
                                        "$HELPER_IMAGE" python -c '
import json, os
e = os.environ
summary = "Pipeline failure: %s #%s failed at stage %s" % (e["JOB_NAME"], e["BUILD_NUMBER"], e["FAILED_STAGE"])
description = chr(10).join([
    "A gate blocked the local DevSecOps pipeline.",
    "Job: " + e["JOB_NAME"],
    "Branch: " + e["TICKET_BRANCH"][:100],
    "Build number: " + e["BUILD_NUMBER"],
    "Failed stage: " + e["FAILED_STAGE"],
    "Reports: see the archived artifacts of this build, for example reports/snyk/snyk-report.txt.",
])
print(json.dumps({"fields": {"project": {"key": e["JIRA_PROJECT_KEY"]}, "summary": summary[:250],
                             "description": description, "issuetype": {"name": "Bug"}}}))
' > "$payload_file"
                                    # Credentials go to curl on stdin, not on its command line; curl's own error
                                    # output is discarded because it can contain the host name.
                                    code="$({ echo "url = ${JIRA_SITE_URL%/}/rest/api/2/issue"; echo "user = $JIRA_EMAIL:$JIRA_API_TOKEN"; } \
                                        | curl -s -K - -X POST -H 'Content-Type: application/json' -H 'Accept: application/json' \
                                            --data-binary @"$payload_file" -o "$response_file" -w '%{http_code}' 2>/dev/null)"
                                    echo "Jira ticket request finished: HTTP ${code:-000}"
                                    if [ "$code" = "201" ]; then
                                        key="$(grep -o '"key":"[^"]*"' "$response_file" | head -1 | cut -d'"' -f4)"
                                        echo "Jira ticket created, number ${key##*-}"
                                    fi
                                    rm -f "$payload_file" "$response_file"
                                    exit 0
                                '''
                            }
                        }
                    } catch (err) {
                        echo 'Jira ticket step could not run; the build result is unchanged.'
                    }
                }
            }
        }
    }
}
