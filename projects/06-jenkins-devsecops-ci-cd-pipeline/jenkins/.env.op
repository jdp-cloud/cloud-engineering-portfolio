# 1Password secret references for the OPTIONAL Snyk and Jira stages. These are pointers, not secrets:
# `op run` reads the real values from 1Password at start-up and hands them to scripts/up.sh as
# environment variables. Nothing in this file can be used without access to the vault.
#
#   op run --env-file=jenkins/.env.op -- ./scripts/up.sh
#
# Items are expected in the vault "Personal" (edit the vault name if yours differs).
SNYK_TOKEN=op://Personal/jenkins-demo-snyk/credential
SNYK_ORG=op://Personal/jenkins-demo-snyk/org
JIRA_API_TOKEN=op://Personal/jenkins-demo-atlassian/credential
JIRA_EMAIL=op://Personal/jenkins-demo-atlassian/email
JIRA_SITE_URL=op://Personal/jenkins-demo-atlassian/site_url
JIRA_PROJECT_KEY=op://Personal/jenkins-demo-atlassian/project_key
