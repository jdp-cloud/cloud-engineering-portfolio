      "link": null,
      "locked": false,
      "text": "How a request becomes a searchable log line",
      "fontSize": 26,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How a request becomes a searchable log line",
