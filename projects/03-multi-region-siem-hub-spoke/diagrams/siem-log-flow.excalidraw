      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Steps 1 to 4 happen in each of the seven web regions. In the six spokes the log then leaves through the spoke Transit Gateway (step 5);\nthe Tokyo web VPC attaches to the hub Transit Gateway directly.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Steps 1 to 4 happen in each of the seven web regions. In the six spokes the log then leaves through the spoke Transit Gateway (step 5);\nthe Tokyo web VPC attaches to the hub Transit Gateway directly.",
      "autoResize": true,
      "lineHeight": 1.25
    },
