tex="1" parent="e-siem-nat"><mxGeometry relative="1" x="0" y="-12" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e-op-ssm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;elbow=vertical;strokeColor=#232F3E;strokeWidth=2;fontFamily=Helvetica;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="operator" target="c-ssm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-ssm-siem" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;elbow=vertical;strokeColor=#232F3E;strokeWidth=2;fontFamily=Helvetica;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-ssm" target="c-siem"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="725" y="860"/><mxPoint x="725" y="620"/></Array></mxGeometry></mxCell><mxCell id="e-ssm-siem-l" value="SSM session" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=none;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e-ssm-siem"><mxGeometry relative="1" x="-0.15" y="12" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="st1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="165" y="274" width="28" height="28" as="geometry"/></mxCell><mxCell id="st2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="440" y="375" width="28" height="28" as="geometry"/></mxCell><mxCell id="st3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="440" y="530" width="28" height="28" as="geometry"/></mxCell><mxCell id="st4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="612" y="575" width="28" height="28" as="geometry"/></mxCell><mxCell id="st5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="860" y="405" width="28" height="28" as="geometry"/></mxCell><mxCell id="st6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="470" y="822" width="28" height="28" as="geometry"/></mxCell><mxCell id="legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1610" y="30" width="520" height="930" as="geometry"/></mxCell><mxCell id="lg0-b" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1630" y="62" width="40" height="38" as="geometry"/></mxCell><mxCell id="lg0-t" value="&lt;div&gt;&lt;b&gt;Internet users to the load balancer&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Users send HTTP :80 to the ALB in their nearest region. The Tokyo web VPC works the same way.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1682" y="60" width="430" height="105" as="geometry"/></mxCell><mxCell id="lg1-b" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1630" y="177" width="40" height="38" as="geometry"/></mxCell><mxCell id="lg1-t" value="&lt;div&gt;&lt;b&gt;ALB to web instances&lt;/b&gt;&lt;/div&gt;&lt;div&gt;The ALB forwards only to the web security group. Instances sit in private subnets.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1682" y="175" width="430" height="105" as="geometry"/></mxCell><mxCell id="lg2-b" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1630" y="292" width="40" height="38" as="geometry"/></mxCell><mxCell id="lg2-t" value="&lt;div&gt;&lt;b&gt;Promtail ships the log line&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Promtail runs as an unprivileged user and pushes to the SIEM at 10.77.0.10:3100.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1682" y="290" width="430" height="105" as="geometry"/></mxCell><mxCell id="lg3-b" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1630" y="407" width="40" height="38" as="geometry"/></mxCell><mxCell id="lg3-t" value="&lt;div&gt;&lt;b&gt;Spoke to hub over Transit Gateway&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Peering carries the traffic over the AWS backbone. Routes are explicit and spokes cannot reach each other.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1682" y="405" width="430" height="105" as="geometry"/></mxCell><mxCell id="lg4-b" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1630" y="522" width="40" height="38" as="geometry"/></mxCell><mxCell id="lg4-t" value="&lt;div&gt;&lt;b&gt;Into the security zone&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Only TCP 3100 from the seven web CIDRs is allowed. nginx accepts pushes only, queries get 403, and Loki and Grafana listen on localhost.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1682" y="520" width="430" height="105" as="geometry"/></mxCell><mxCell id="lg5-b" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1630" y="637" width="40" height="38" as="geometry"/></mxCell><mxCell id="lg5-t" value="&lt;div&gt;&lt;b&gt;Operator access&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Session Manager only. No SSH, no bastion, no key pairs. Grafana is reached by port-forward.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1682" y="635" width="430" height="105" as="geometry"/></mxCell><mxCell id="legend-lines" value="&lt;b&gt;Line styles&lt;/b&gt;&lt;br&gt;Solid: request and log data path&lt;br&gt;Dashed pink: allowed path (Aurora, from Tokyo web only)&lt;br&gt;Dashed dark: operator session&lt;br&gt;&lt;i&gt;The NAT gateway sits in the only public subnet.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1630" y="760" width="480" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>